<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext traffic is forbidden; development builds may allow the local
     stack through the debug overlay in src/debug. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>
