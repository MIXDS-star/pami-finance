# Server-side secrets for Supabase Edge Functions. Copy to supabase/functions/.env
# for local use, or set them with `supabase secrets set` in each environment.
# NEVER put these in the mobile app.

# Text interpretation, receipt reading and copilot (Claude). Leave empty to keep
# these capabilities in the honest "not configured" state.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# anthropic | openai_compatible. Empty = Claude if ANTHROPIC_API_KEY is set,
# otherwise the OpenAI-compatible provider below if AI_API_KEY is set.
AI_TEXT_PROVIDER=

# Any provider exposing POST {url}/chat/completions (Groq, Gemini, OpenRouter…).
# Example with Groq's free tier (check current model names in its console):
#   AI_API_URL=https://api.groq.com/openai/v1
#   AI_TEXT_MODEL=llama-3.3-70b-versatile
#   AI_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
AI_API_URL=
AI_API_KEY=
AI_TEXT_MODEL=
AI_VISION_MODEL=
AI_JSON_SCHEMA=false
AI_PROVIDER_LABEL=

# Speech-to-text: any provider exposing POST {url}/audio/transcriptions.
TRANSCRIPTION_API_URL=
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=whisper-1
# Groq: TRANSCRIPTION_API_URL=https://api.groq.com/openai/v1  TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# Provided automatically by Supabase in hosted Edge Functions:
# SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY
