<?xml version="1.0" encoding="utf-8"?>
<!-- Financial data and session tokens are never included in cloud backups
     or device-to-device transfers. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root"/>
        <exclude domain="sharedpref"/>
        <exclude domain="database"/>
        <exclude domain="file"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="root"/>
        <exclude domain="sharedpref"/>
        <exclude domain="database"/>
        <exclude domain="file"/>
    </device-transfer>
</data-extraction-rules>
